# Supabase (optional). When both are unset the app runs in DEMO MODE:
# signed-cookie auth + in-memory tenant store + Northstar sample data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret used to sign demo-mode session cookies. REQUIRED in production demo deployments.
AUTH_SECRET=change-me-to-a-long-random-string
