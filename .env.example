# Postgres connection (Supabase, Neon, RDS, local…). When unset, Phoonica runs on an embedded
# PGlite database in ./.data/pglite and seeds the Brightline demo workspace on first start.
DATABASE_URL=
# Max connections per server instance (use a small number behind pgbouncer / serverless).
DATABASE_POOL_MAX=10

# Secret used to sign session cookies. REQUIRED in production.
AUTH_SECRET=change-me-to-a-long-random-string

# Providers (all default to the built-in demo implementations). See src/lib/providers.
PHONE_PROVIDER=demo
EMAIL_PROVIDER=demo
AI_PROVIDER=demo
ENRICHMENT_PROVIDER=demo
CALENDAR_PROVIDER=demo
